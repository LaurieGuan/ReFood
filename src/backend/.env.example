# Local-only Flask settings. Copy to .env; .env is gitignored.
FLASK_APP=app:create_app
FLASK_DEBUG=0
CORS_ORIGINS=*
# Set DATABASE_URL for MariaDB persistence (otherwise pantry/recipes use demo storage).
DATABASE_URL=
# Gemini via OpenAI-compatible endpoint; replace model if using another provider.
VISION_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
VISION_MODEL=gemini-3-flash-preview
VISION_API_KEY=
